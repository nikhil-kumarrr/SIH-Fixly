PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/fixly
REDIS_URL=redis://127.0.0.1:6379

# Firebase Admin SDK for FCM. Project: ai-agent-29433
# Local: set FCM_* from a service account JSON (never commit the JSON).
# Production: prefer Application Default Credentials.
FCM_PROJECT_ID=ai-agent-29433
FCM_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace_me\\n-----END PRIVATE KEY-----\\n"
# Set this instead when the runtime provides Application Default Credentials.
# FCM_USE_APPLICATION_DEFAULT=true

JWT_SECRET=change_me_access_secret
REFRESH_SECRET=change_me_refresh_secret

# Razorpay — put real values in `.env` (never commit `.env`)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# AI / ML Microservices Feature Toggles (true = call Python ML API, false = use direct manual / built-in fallback)
AI_VERIFY_ENABLED=false
AI_DISCOVERY_ENABLED=false

# Python ML Microservice Endpoints (Used when enabled above)
SERVICE_DISCOVERY_URL=http://127.0.0.1:8002
IDENTITY_VERIFY_URL=http://127.0.0.1:8004

